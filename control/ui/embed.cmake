# cmake -DWEB=<dir> -DOUT=<file.cpp> -P embed.cmake
# Writes the asset table (src/embedded.hpp) for every file under WEB except tests/ and
# dot-files, the same selection as CMakeLists.txt. Paths are relative to WEB.
file(GLOB_RECURSE files LIST_DIRECTORIES false ${WEB}/*)
list(FILTER files EXCLUDE REGEX "^${WEB}/tests/")
list(FILTER files EXCLUDE REGEX "/\\.[^/]*$")
list(SORT files)

set(body "// Generated by control/ui/embed.cmake from control/ui/web. Do not edit.\n")
string(APPEND body "#include \"embedded.hpp\"\n\nnamespace tdr::cpui::detail {\nnamespace {\n")
set(table "")
set(i 0)
foreach(f IN LISTS files)
    file(RELATIVE_PATH rel ${WEB} ${f})
    if(rel MATCHES "[\"\\\\]" OR rel MATCHES "[\r\n]")
        message(FATAL_ERROR "control/ui/web: unsupported file name '${rel}'")
    endif()
    file(READ ${f} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    if(size EQUAL 0)
        set(bytes "0x00")
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # 16 bytes per line (CMake regexes have no {n})
        string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line)
        string(REGEX REPLACE "(${line})" "\\1\n" bytes "${bytes}")
    endif()
    string(APPEND body "const unsigned char f${i}[] = {\n${bytes}\n};\n")
    string(APPEND table "    {\"${rel}\", f${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "}  // namespace\n\n")
string(APPEND body "const EmbeddedFile kEmbedded[] = {\n${table}    {nullptr, nullptr, 0},\n};\n")
string(APPEND body "const std::size_t kEmbeddedCount = ${i};\n\n}  // namespace tdr::cpui::detail\n")

# Rewrite only on change, so an unrelated re-run doesn't recompile.
set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL body)
    file(WRITE ${OUT} "${body}")
endif()
