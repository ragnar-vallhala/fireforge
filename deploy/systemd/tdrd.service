[Unit]
Description=FireForge TDR daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tdrd --config /etc/fireforge/tdr.conf
Restart=on-failure
RestartSec=2
# Lets tdrd create per-job cgroups under its own cgroup.
Delegate=yes
User=fireforge
Group=fireforge
# Jobs run as job_user (tdr.conf). tdrd needs these to start and stop them;
# every job process drops all capabilities before exec (phase1.md §11).
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_KILL
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
StateDirectory=fireforge
StateDirectoryMode=0711
LogsDirectory=fireforge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fireforge /var/log/fireforge
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
