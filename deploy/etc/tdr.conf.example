# /etc/fireforge/tdr.conf
# Every key is optional. Values shown are the defaults.

[control]
# Empty = standalone node (Phase 1). Set in Phase 2.
address =
port = 8080
scheme = https
# Phase 4: run jobs leased from the control plane (on|off), and how often to ask (seconds).
remote_jobs = on
lease_poll = 2
lease_poll_idle = 10

[node]
# Default: hostname
name =
# auto = detect (LAN + Tailscale), one address, or an explicit list
# "type=addr[:port], ...", e.g. "lan=192.168.1.5, tailscale=100.64.0.3:7400".
advertise_address = auto

[network]
listen_address = 0.0.0.0
listen_port = 7400
tailscale = auto
# Peer links (Phase 3): ping every N seconds; close a link silent for M seconds.
peer_ping_interval = 5
peer_ping_timeout = 15
# Phase 5: cap on the total rate this node serves artifacts to peers (Mbit/s), 0 = unlimited.
max_transfer_mbps = 0

[resources]
# 0 = all online CPUs
max_cpu_cores = 0
# 0 = 80% of physical RAM
max_memory_mb = 0
# 0 = same as max_cpu_cores
max_jobs = 0
# Artifact store cap (Phase 5 GC evicts copies held elsewhere), 0 = unlimited
max_disk_mb = 0
# Memory reserved for a job that requests 0
default_job_memory_mb = 1024
# auto | required | off
cgroups = auto
# Run job processes as this unprivileged user (e.g. fireforge-job).
# Empty = same user as tdrd (development only). See docs/design/phase1.md §11.
job_user =

[artifacts]
# Phase 5 store GC: evict least-recently-used copies that another node also holds
# when the store exceeds gc_high % of max_disk_mb, down to gc_low %. The last copy
# and pinned artifacts are never evicted.
gc_high = 90
gc_low = 80
gc_interval = 60
# Artifacts used within this many seconds are never evicted.
gc_min_age = 600
# Phase 6: ask this many connected peers (lowest RTT first) to copy each new job
# checkpoint, so a retry on another node can resume after this node dies.
checkpoint_replicas = 1

[tls]
# mTLS credentials for the control plane (issued with `tdrctl pki issue --role node`).
ca_file = /etc/fireforge/certificates/ca.crt
cert_file = /etc/fireforge/certificates/node.crt
key_file = /etc/fireforge/node.key

[paths]
state_dir = /var/lib/fireforge
# Empty = stderr only (captured by journald)
log_file =

[log]
# debug | info | warn | error
level = info
