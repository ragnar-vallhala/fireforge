# /etc/fireforge/tdrcp.conf — FireForge control plane (docs/design/phase2.md §8)

[server]
listen_address = 0.0.0.0
port = 8080

[tls]
# Server cert issued with `tdrctl pki issue DIR --role server NAME --dns HOST --ip ADDR`.
ca_file = /etc/fireforge/certificates/ca.crt
cert_file = /etc/fireforge/certificates/server.crt
key_file = /etc/fireforge/server.key

[database]
# libpq conninfo or URI.
conninfo = postgresql:///fireforge

[health]
# Seconds. Nodes heartbeat every heartbeat_interval; STALE after stale_after
# without one, OFFLINE after offline_after.
heartbeat_interval = 10
stale_after = 30
offline_after = 90

[jobs]
# Central job queue (docs/design/phase4.md §3). Seconds. Leases are renewed
# by heartbeats; keep lease_ttl >= 3 x heartbeat_interval. For lease_ttl after
# tdrcp starts nothing expires, so nodes can renew after an outage.
#lease_ttl = 60
# Used when a submitted job leaves policy.max_attempts at 0.
#max_attempts_default = 3
# Placement (docs/design/phase5.md §4): a job with input artifacts goes to a
# node holding all of them first; after it has been queued this many seconds,
# any node may take it and fetch the inputs from a peer. 0 = any node at once.
#locality_wait = 15

[workflows]
# Workflow engine (docs/design/phase6.md §3-§5). The engine runs whenever a
# step's job finishes; this sweep (seconds) is only a safety net.
#sweep_interval = 5
# Steps per workflow (static + spawned), steps per fan-out, spawn nesting depth.
#max_steps = 10000
#max_spawn = 1000
#max_depth = 8

[placement]
# Ranked placement (docs/design/phase6.md §7). Strict jobs (gpu_count > 0, or
# inputs + checkpoint >= strict_input_mb MiB) are reserved for their best-ranked
# node for reserve_window seconds, then the next one; after every eligible node
# was tried, or max_reserve seconds after queueing, any node may take them.
# Strict jobs are only leasable through this sweep, so interval must be > 0.
#interval = 1
#reserve_window = 5
#max_reserve = 30
#strict_input_mb = 64
# Cost weights (each term is roughly 0..1; lowest total cost wins).
#w_compute = 0.1
#w_transfer = 0.5
#w_queue = 0.2
#w_memory = 0.1
#w_contention = 0.1

[gangs]
# Multi-node MPI jobs (docs/design/phase7.md §3). The placement sweep picks the
# member nodes and holds their capacity (other jobs drain off them); the gang is
# leased once every member polled with room for its hold within ready_window
# seconds. A hold not ready after drain_timeout seconds is dropped and another
# set of nodes is preferred. max_nodes caps the members, max_ranks mpi.ranks.
#drain_timeout = 600
#ready_window = 5
#max_nodes = 16
#max_ranks = 4096

[ui]
# Web dashboard (docs/design/phase9.md) at https://HOST:PORT/ui/, served from files
# compiled into tdrcp. Browsers need a client certificate (`tdrctl pki issue DIR
# --role viewer|admin NAME`, then `tdrctl pki p12 DIR NAME`), must trust ca.crt as an
# authority, and the server certificate needs the browser's host name or IP as a SAN.
# false: / and /ui/* return 404.
#enabled = true

[log]
level = info
