# /etc/fireforge/tdrcp.conf — FireForge control plane (docs/design/phase2.md §8)

[server]
listen_address = 0.0.0.0
port = 8080

[tls]
# Server cert issued with `tdrctl pki issue DIR --role server NAME --dns HOST --ip ADDR`.
ca_file = /etc/fireforge/certificates/ca.crt
cert_file = /etc/fireforge/certificates/server.crt
key_file = /etc/fireforge/server.key

[database]
# libpq conninfo or URI.
conninfo = postgresql:///fireforge

[health]
# Seconds. Nodes heartbeat every heartbeat_interval; STALE after stale_after
# without one, OFFLINE after offline_after.
heartbeat_interval = 10
stale_after = 30
offline_after = 90

[jobs]
# Central job queue (docs/design/phase4.md §3). Seconds. Leases are renewed
# by heartbeats; keep lease_ttl >= 3 x heartbeat_interval. For lease_ttl after
# tdrcp starts nothing expires, so nodes can renew after an outage.
#lease_ttl = 60
# Used when a submitted job leaves policy.max_attempts at 0.
#max_attempts_default = 3
# Placement (docs/design/phase5.md §4): a job with input artifacts goes to a
# node holding all of them first; after it has been queued this many seconds,
# any node may take it and fetch the inputs from a peer. 0 = any node at once.
#locality_wait = 15

[log]
level = info
